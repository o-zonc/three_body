scoreboard players operation #blue_ten_to_lapis tmp = #blue_to_lapis tmp
scoreboard players operation #blue_ten_to_lapis tmp *= #color_ui_ten tmp
scoreboard players operation #blue_all_to_iron tmp = #blue_to_iron tmp
scoreboard players operation #blue_all_to_iron tmp *= #blue material
